    <string name="slideshow_protection_error">Couldn\'t set up acquisition protection. Please try again.</string>

    <!-- Post-acquisition: set a password (tutorial-style screen) -->
    <string name="set_password_title">Set an acquisition password</string>
    <string name="set_password_mandatory_description">This device has no screen lock, so a password is the only protection. It is needed to open or export acquisitions and can\'t be recovered. Leaving without one discards this acquisition.</string>
    <string name="set_password_tee_description">Add a password for stronger protection: on this device it guards acquisitions against a forensic tool better than the screen lock alone.</string>
    <string name="set_password_se_description">Optionally add a password on top of your screen lock. Both are then needed to read acquisitions, even if this phone is fully compromised, and they stay readable if you remove the screen lock.</string>

    <!-- Screen lock removed: the biometric-gated key was permanently invalidated -->
