    <!-- Role slide (once per install) -->
    <string name="slideshow_role_title">Who is using Bugbane?</string>
    <string name="slideshow_role_description">Bugbane checks this phone for signs of spyware.\n\nAnalysts scanning other people\'s devices from this phone should choose analyst mode below. The choice is permanent: to change it, clear the app\'s data.</string>
    <string name="slideshow_role_user_button">Check this device</string>
    <string name="slideshow_role_analyst_button">I\'m an analyst: scan other devices instead</string>
    <string name="slideshow_protection_analyst_description">An analyst install holds other people\'s data, so a screen lock and an acquisition password are both required. Set a screen lock first if this phone has none.</string>
    <string name="set_password_analyst_description">Choose the acquisition password. With your screen lock, it is needed to open or export acquisitions. It can\'t be recovered, so store it safely.</string>

    <!-- Analyst home -->
    <string name="home_scan_device_button">Scan a device</string>
    <string name="scan_analyst_welcome_title">Scan a device</string>
    <string name="scan_analyst_welcome_description">Have the device to scan at hand and a USB cable if possible, then press “Scan a device”.</string>

    <!-- Analyst scan wizard -->
    <string name="remote_transport_title">How is the device connected?</string>
    <string name="remote_transport_description">A USB cable is faster and more reliable. Over Wi‑Fi, this phone shares a network with no internet access for the other device to join.</string>
    <string name="remote_transport_usb_button">Use a USB cable</string>
    <string name="remote_transport_wifi_button">Use Wi‑Fi instead</string>
