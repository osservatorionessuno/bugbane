    <string name="remote_usb_permission_denied">Access to the USB device was denied. Reconnect the cable and allow Bugbane to access it.</string>
    <string name="remote_usb_connect_failed">The USB connection failed. Check USB debugging is on and the prompt on the other device was accepted, then retry.</string>
    <string name="remote_usb_allow_title">Allow USB debugging</string>
    <string name="remote_usb_allow_description">On the other device, accept “Allow USB debugging?”. Leave “Always allow” unticked so this phone\'s key is not kept on it.</string>
    <string name="remote_connecting_title">Connecting…</string>
    <string name="remote_connecting_description">Pairing with the device and opening the connection.</string>
    <string name="remote_hotspot_title">Join this phone\'s network</string>
    <string name="remote_hotspot_description">This phone is sharing a Wi‑Fi network without internet. On the device to scan, scan this code with the camera or from Wi‑Fi settings, or enter the details by hand.</string>
    <string name="remote_hotspot_permission">Android needs the nearby devices permission to share a network. Bugbane does not use your location.</string>
    <string name="remote_hotspot_permission_button">Allow</string>
    <string name="remote_hotspot_location_hint">On this Android version, Location must be on for the network to start.</string>
    <string name="remote_hotspot_error">Couldn\'t share the network. Make sure Wi‑Fi is on and no other Wi‑Fi Direct connection, hotspot or tethering is active, then try again.</string>
    <string name="remote_hotspot_keep_open">Keep Bugbane open: on this phone the shared network stops if you leave the app.</string>
