    <string name="slideshow_welcome_description">This application helps with consensual forensic analysis of Android devices to identify signs of compromise or surveillance.
    \n\n
    The absence of detection from this app does not mean that your device is safe or secure.
    \n</string>
    <string name="slideshow_unsupported_version">Bugbane needs Android 11 or newer. Use AndroidQF or MVT from a trusted computer instead.</string>
    <string name="slideshow_button_exit">Exit</string>
    <string name="slideshow_restricted_title">This device is managed</string>
    <string name="slideshow_restricted_description">Bugbane cannot run on this device: a device administrator (for example a work or school policy) has disabled debugging.</string>
    <string name="slideshow_restricted_button">Show who manages this device</string>
    <string name="slideshow_welcome_button">I understand</string>

    <string name="slideshow_wifi_title">Connect to a Trusted Wi-Fi Network</string>
    <string name="slideshow_wifi_description">To continue, connect your device to a protected Wi-Fi network, such as your home network or a personal hotspot.</string>
    <string name="slideshow_wifi_button">Open Wi-Fi Settings</string>
    <string name="slideshow_button_continue">Continue</string>

    <string name="slideshow_notification_title">Enable Notification Permissions</string>
    <string name="slideshow_notification_description">To use this app, you need to enable notification permissions.
    \n\n
    Bugbane shows a notification so you can enter the pairing code for ADB Wireless Debugging.</string>
    <string name="slideshow_notification_button">Enable</string>

    <string name="slideshow_developer_title">Enable Developer Options</string>
    <string name="slideshow_developer_description">To use this app, enable Developer Options in your device settings.
    \n\n
    The application acquires data using ADB Wireless Debugging, which is available only when Developer Options are enabled.</string>
    <string name="slideshow_button_text_enable">Enable</string>

    <!-- ADB wireless-debugging vulnerability warning (CVE-2026-0073) -->
    <string name="adb_vuln_title">Your device needs an update</string>
    <string name="adb_vuln_description">This phone is missing an Android security fix (CVE-2026-0073). While Bugbane scans, other people on the same Wi-Fi network could use that flaw to access the phone. Install system updates first.</string>
    <string name="adb_vuln_network_warning">Can\'t update now? Scan only while connected to a personal hotspot made by another phone or computer you trust — never on shared or public Wi-Fi. Turn Wireless Debugging off right after.</string>
    <string name="adb_vuln_update_button">Check for updates</string>
    <string name="adb_vuln_continue_button">I understand, continue anyway</string>

