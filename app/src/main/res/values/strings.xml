    <!-- Onboarding: acquisition protection step (fingerprint) -->
    <string name="slideshow_protection_title">Protect your acquisitions</string>
    <string name="slideshow_protection_biometric_description">Acquisitions are encrypted and the key is locked to your fingerprint or screen lock, so not even a forensic tool can read them without you.\n\nRemoving the screen lock erases the key. To keep acquisitions readable in that case, set an acquisition password in Settings.</string>
